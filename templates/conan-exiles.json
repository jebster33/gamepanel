{
  "id": "conan-exiles",
  "name": "Conan Exiles",
  "category": "Survival",
  "icon": "⚔️",
  "storeAppId": 440900,
  "description": "Open-world survival in the lands of Conan the Barbarian. Windows only. Workshop mods are copied into ConanSandbox/Mods and listed in modlist.txt for you.",
  "platforms": [
    "windows"
  ],
  "defaultMemory": 8192,
  "variables": [
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "default": 40,
      "type": "number"
    },
    {
      "name": "SERVER_PASSWORD",
      "label": "Join password",
      "default": "",
      "description": "Leave empty for an open server."
    },
    {
      "name": "ADMIN_PASSWORD",
      "label": "Admin password",
      "default": "",
      "generate": "password"
    },
    {
      "name": "RCON_PASSWORD",
      "label": "RCON password",
      "default": "",
      "generate": "password"
    },
    {
      "name": "PVP_ENABLED",
      "label": "PvP",
      "default": "True",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "description": "Turn it off for a PvE server.",
      "group": "Rules"
    },
    {
      "name": "DAMAGE_PLAYER_STRUCTURES",
      "label": "Raiding (damage other players' buildings)",
      "default": "True",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "DROP_EQUIPMENT",
      "label": "Drop equipment on death",
      "default": "True",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "NUDITY",
      "label": "Nudity",
      "default": "0",
      "options": [
        {
          "value": "0",
          "label": "None"
        },
        {
          "value": "1",
          "label": "Partial"
        },
        {
          "value": "2",
          "label": "Full"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "HARVEST_MULTIPLIER",
      "label": "Harvest amount multiplier",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "XP_RATE",
      "label": "Player XP multiplier",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "NPC_RESPAWN",
      "label": "NPC respawn multiplier",
      "type": "number",
      "default": 1,
      "description": "Lower is slower.",
      "group": "Rates"
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "query",
      "default": 27015,
      "protocol": "udp",
      "offset": 19238
    },
    {
      "name": "rcon",
      "default": 25575,
      "protocol": "tcp",
      "offset": 17798
    }
  ],
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "443030",
        "label": "Install the Conan Exiles dedicated server"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      },
      {
        "type": "directx",
        "label": "Install the DirectX runtime"
      }
    ]
  },
  "patchProperties": [
    {
      "path": "ConanSandbox/Saved/Config/WindowsServer/Engine.ini",
      "format": "ini",
      "section": "OnlineSubsystem",
      "createIfMissing": true,
      "set": {
        "ServerName": "{{SERVER_NAME}}",
        "ServerPassword": "{{SERVER_PASSWORD}}"
      }
    },
    {
      "path": "ConanSandbox/Saved/Config/WindowsServer/Game.ini",
      "format": "ini",
      "section": "RconPlugin",
      "createIfMissing": true,
      "set": {
        "RconEnabled": "1",
        "RconPassword": "{{RCON_PASSWORD}}",
        "RconPort": "{{PORT_RCON}}"
      }
    },
    {
      "path": "ConanSandbox/Saved/Config/WindowsServer/ServerSettings.ini",
      "format": "ini",
      "section": "ServerSettings",
      "createIfMissing": true,
      "set": {
        "AdminPassword": "{{ADMIN_PASSWORD}}",
        "MaxNudity": "{{NUDITY}}",
        "PVPEnabled": "{{PVP_ENABLED}}",
        "CanDamagePlayerOwnedStructures": "{{DAMAGE_PLAYER_STRUCTURES}}",
        "DropEquipmentOnDeath": "{{DROP_EQUIPMENT}}",
        "HarvestAmountMultiplier": "{{HARVEST_MULTIPLIER}}",
        "PlayerXPRateMultiplier": "{{XP_RATE}}",
        "NPCRespawnMultiplier": "{{NPC_RESPAWN}}"
      }
    }
  ],
  "startCommand": "ConanSandboxServer.exe -log -Port={{PORT}} -QueryPort={{PORT_QUERY}} -MaxPlayers={{MAX_PLAYERS}}",
  "tailFiles": [
    "ConanSandbox/Saved/Logs/ConanSandbox.log"
  ],
  "consoleInput": false,
  "rcon": {
    "type": "source",
    "port": "rcon"
  },
  "stopRconCommand": "shutdown",
  "query": {
    "type": "a2s",
    "port": "query"
  },
  "readyOnPort": "game",
  "logPatterns": {
    "ready": "LogServerStats|Server is ready"
  },
  "stopTimeout": 90,
  "mods": {
    "providers": [
      "workshop"
    ],
    "dir": "ConanSandbox/Mods",
    "appId": 440900,
    "workshop": {
      "strategy": "modlist",
      "file": "ConanSandbox/Mods/modlist.txt"
    }
  },
  "presets": [
    {
      "id": "normal",
      "label": "Normal",
      "description": "standard rates",
      "vars": {
        "HARVEST_MULTIPLIER": 1,
        "XP_RATE": 1,
        "NPC_RESPAWN": 1
      }
    },
    {
      "id": "2x",
      "label": "2x",
      "description": "double harvest and XP",
      "vars": {
        "HARVEST_MULTIPLIER": 2,
        "XP_RATE": 2,
        "NPC_RESPAWN": 1
      }
    },
    {
      "id": "5x",
      "label": "5x",
      "description": "five times harvest and XP",
      "vars": {
        "HARVEST_MULTIPLIER": 5,
        "XP_RATE": 5,
        "NPC_RESPAWN": 0.8
      }
    },
    {
      "id": "pve",
      "label": "PvE",
      "description": "no player damage or raiding",
      "vars": {
        "PVP_ENABLED": "False",
        "DAMAGE_PLAYER_STRUCTURES": "False",
        "DROP_EQUIPMENT": "False"
      }
    }
  ]
}
