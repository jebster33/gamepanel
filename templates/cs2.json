{
  "id": "cs2",
  "name": "Counter-Strike 2",
  "category": "Shooter",
  "icon": "🔫",
  "description": "Counter-Strike 2 dedicated server. A Game Server Login Token (GSLT) is required for public internet servers — get one at steamcommunity.com/dev/managegameservers.",
  "defaultMemory": 4096,
  "variables": [
    {
      "name": "GSLT",
      "label": "Steam game server token (GSLT)",
      "default": "",
      "description": "Leave empty for LAN-only play."
    },
    {
      "name": "MAP",
      "label": "Starting map",
      "default": "de_dust2",
      "options": [
        "de_dust2",
        "de_mirage",
        "de_inferno",
        "de_nuke",
        "de_overpass",
        "de_ancient",
        "de_anubis",
        "de_vertigo",
        "de_train",
        "cs_office",
        "cs_italy"
      ],
      "allowCustom": true
    },
    {
      "name": "GAME_MODE",
      "label": "Game mode",
      "default": "1",
      "options": [
        {
          "value": "0",
          "label": "Casual"
        },
        {
          "value": "1",
          "label": "Competitive"
        },
        {
          "value": "2",
          "label": "Wingman"
        }
      ],
      "description": "Wingman also needs game type 0."
    },
    {
      "name": "GAME_TYPE",
      "label": "Game type",
      "default": "0",
      "options": [
        {
          "value": "0",
          "label": "Classic"
        },
        {
          "value": "1",
          "label": "Gun game / arms race"
        }
      ]
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "type": "number",
      "default": 12
    },
    {
      "name": "RCON_PASSWORD",
      "label": "RCON password",
      "generate": "password",
      "default": ""
    },
    {
      "name": "SERVER_PASSWORD",
      "label": "Join password",
      "default": ""
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "tv",
      "default": 27020,
      "protocol": "udp",
      "offset": 5
    }
  ],
  "install": [
    {
      "type": "steamcmd",
      "appid": "730",
      "label": "Install Counter-Strike 2 (~35 GB)"
    },
    {
      "type": "chmod",
      "path": "game/bin/linuxsteamrt64/cs2",
      "mode": "+x"
    }
  ],
  "configFiles": [
    {
      "path": "game/csgo/cfg/gamepanel.cfg",
      "mode": "create",
      "content": "hostname \"{{SERVER_NAME}}\"\nrcon_password \"{{RCON_PASSWORD}}\"\nsv_password \"{{SERVER_PASSWORD}}\"\nsv_lan 0\nsv_cheats 0\n"
    }
  ],
  "startCommand": "./game/bin/linuxsteamrt64/cs2 -dedicated -console -usercon -port {{PORT}} +tv_port {{PORT_TV}} +game_type {{GAME_TYPE}} +game_mode {{GAME_MODE}} +map {{MAP}} +sv_visiblemaxplayers {{MAX_PLAYERS}} +rcon_password \"{{RCON_PASSWORD}}\" +sv_setsteamaccount \"{{GSLT}}\" +exec gamepanel.cfg",
  "stopCommand": "quit",
  "stopTimeout": 45,
  "query": {
    "type": "a2s",
    "port": "game"
  },
  "rcon": {
    "type": "source",
    "port": "game"
  },
  "logPatterns": {
    "ready": "Connection to Steam servers successful|GC Connection established",
    "join": "\"([^<]+)<[0-9]+><\\[?U?:?[0-9:]+\\]?><>\" entered the game",
    "leave": "\"([^<]+)<[0-9]+><\\[?U?:?[0-9:]+\\]?><[^>]*>\" disconnected"
  },
  "image": "cm2network/steamcmd:root"
}
