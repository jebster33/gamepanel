{
  "id": "cs2",
  "name": "Counter-Strike 2",
  "category": "Shooter",
  "icon": "🔫",
  "storeAppId": 730,
  "description": "Counter-Strike 2 dedicated server. A Game Server Login Token (GSLT) is required for public internet servers — get one at steamcommunity.com/dev/managegameservers.",
  "defaultMemory": 4096,
  "variables": [
    {
      "name": "GSLT",
      "label": "Steam game server token (GSLT)",
      "default": "",
      "description": "Leave empty for LAN-only play."
    },
    {
      "name": "MAP",
      "label": "Starting map",
      "default": "de_dust2",
      "options": [
        "de_dust2",
        "de_mirage",
        "de_inferno",
        "de_nuke",
        "de_overpass",
        "de_ancient",
        "de_anubis",
        "de_vertigo",
        "de_train",
        "cs_office",
        "cs_italy"
      ],
      "allowCustom": true
    },
    {
      "name": "GAME_MODE",
      "label": "Game mode",
      "default": "1",
      "options": [
        {
          "value": "0",
          "label": "Casual"
        },
        {
          "value": "1",
          "label": "Competitive"
        },
        {
          "value": "2",
          "label": "Wingman"
        }
      ],
      "description": "Wingman also needs game type 0."
    },
    {
      "name": "GAME_TYPE",
      "label": "Game type",
      "default": "0",
      "options": [
        {
          "value": "0",
          "label": "Classic"
        },
        {
          "value": "1",
          "label": "Gun game / arms race"
        }
      ]
    },
    {
      "name": "MAPGROUP",
      "label": "Map group",
      "default": "mg_active",
      "description": "Maps offered by the end-of-match vote. The CS2 tab in the panel manages this; leave it as mg_active for the official group."
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "type": "number",
      "default": 12
    },
    {
      "name": "RCON_PASSWORD",
      "label": "RCON password",
      "generate": "password",
      "default": ""
    },
    {
      "name": "SERVER_PASSWORD",
      "label": "Join password",
      "default": ""
    },
    {
      "name": "FRIENDLY_FIRE",
      "label": "Friendly fire",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "description": "Teammates can hurt each other.",
      "group": "Rules"
    },
    {
      "name": "ROUND_TIME",
      "label": "Round time (minutes)",
      "type": "number",
      "default": "",
      "description": "Blank keeps the game default.",
      "group": "Rules"
    },
    {
      "name": "FREEZE_TIME",
      "label": "Freeze time (seconds)",
      "type": "number",
      "default": "",
      "description": "The pause at the start of a round.",
      "group": "Rules"
    },
    {
      "name": "START_MONEY",
      "label": "Starting money",
      "type": "number",
      "default": "",
      "description": "Blank keeps the game default.",
      "group": "Rules"
    },
    {
      "name": "MAX_ROUNDS",
      "label": "Rounds per map",
      "type": "number",
      "default": "",
      "description": "0 means no limit.",
      "group": "Rules"
    },
    {
      "name": "AUTO_TEAM_BALANCE",
      "label": "Auto team balance",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "ALLTALK",
      "label": "Everyone can hear everyone",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "description": "Dead players and the other team hear voice chat too.",
      "group": "Rules"
    },
    {
      "name": "BOT_QUOTA",
      "label": "Bots",
      "type": "number",
      "default": "",
      "description": "How many bots fill the server. 0 for none.",
      "group": "Rules"
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "tv",
      "default": 27020,
      "protocol": "udp",
      "offset": 5
    }
  ],
  "install": [
    {
      "type": "steamcmd",
      "appid": "730",
      "label": "Install Counter-Strike 2 (~35 GB)"
    },
    {
      "type": "chmod",
      "path": "game/bin/linuxsteamrt64/cs2",
      "mode": "+x"
    }
  ],
  "configFiles": [
    {
      "path": "game/csgo/cfg/gamepanel-preset.cfg",
      "mode": "create",
      "content": "// Written by the CS2 tab (game-mode presets and map vote). Empty until you apply one.\n"
    },
    {
      "path": "game/csgo/cfg/gamepanel.cfg",
      "mode": "create",
      "content": "hostname \"{{SERVER_NAME}}\"\nrcon_password \"{{RCON_PASSWORD}}\"\nsv_password \"{{SERVER_PASSWORD}}\"\nsv_lan 0\nsv_cheats 0\n"
    },
    {
      "path": "game/csgo/cfg/gamepanel-rules.cfg",
      "mode": "overwrite",
      "content": "// Written by GamePanel from the game settings. A blank value leaves the game default alone.\nmp_friendlyfire {{FRIENDLY_FIRE}}\nmp_roundtime {{ROUND_TIME}}\nmp_freezetime {{FREEZE_TIME}}\nmp_startmoney {{START_MONEY}}\nmp_maxrounds {{MAX_ROUNDS}}\nmp_autoteambalance {{AUTO_TEAM_BALANCE}}\nsv_alltalk {{ALLTALK}}\nbot_quota {{BOT_QUOTA}}\n"
    }
  ],
  "startCommand": "LD_LIBRARY_PATH=\"$PWD/game/bin/linuxsteamrt64:$LD_LIBRARY_PATH\" ./game/bin/linuxsteamrt64/cs2 -dedicated -console -usercon -port {{PORT}} +tv_port {{PORT_TV}} +game_type {{GAME_TYPE}} +game_mode {{GAME_MODE}} +mapgroup {{MAPGROUP}} +map {{MAP}} +sv_visiblemaxplayers {{MAX_PLAYERS}} +rcon_password \"{{RCON_PASSWORD}}\" +sv_setsteamaccount \"{{GSLT}}\" +exec gamepanel.cfg +exec gamepanel-rules.cfg +exec gamepanel-preset.cfg",
  "stopCommand": "quit",
  "stopTimeout": 45,
  "query": {
    "type": "a2s",
    "port": "game"
  },
  "rcon": {
    "type": "source",
    "port": "game"
  },
  "logPatterns": {
    "ready": "Connection to Steam servers successful|GC Connection established",
    "join": "\"([^<]+)<[0-9]+><\\[?U?:?[0-9:]+\\]?><>\" entered the game",
    "leave": "\"([^<]+)<[0-9]+><\\[?U?:?[0-9:]+\\]?><[^>]*>\" disconnected"
  },
  "image": "cm2network/steamcmd:root",
  "platforms": [
    "linux",
    "windows"
  ],
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "730",
        "label": "Install Counter-Strike 2 (~35 GB)"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      }
    ],
    "startCommand": "game\\bin\\win64\\cs2.exe -dedicated -console -usercon -condebug -port {{PORT}} +tv_port {{PORT_TV}} +game_type {{GAME_TYPE}} +game_mode {{GAME_MODE}} +mapgroup {{MAPGROUP}} +map {{MAP}} +sv_visiblemaxplayers {{MAX_PLAYERS}} +rcon_password \"{{RCON_PASSWORD}}\" +sv_setsteamaccount \"{{GSLT}}\" +exec gamepanel.cfg +exec gamepanel-rules.cfg +exec gamepanel-preset.cfg",
    "tailFiles": [
      "game/csgo/console.log"
    ],
    "consoleInput": false,
    "stopCommand": null,
    "stopRconCommand": "quit"
  },
  "ci": {
    "windows": {
      "skip": "about 35 GB, more than the Windows CI runner has free"
    }
  }
}
