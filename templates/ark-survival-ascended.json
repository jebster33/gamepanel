{
  "id": "ark-survival-ascended",
  "name": "ARK: Survival Ascended",
  "category": "Survival",
  "icon": "🦖",
  "storeAppId": 2399830,
  "description": "The Unreal Engine 5 remake of ARK. Windows only: Studio Wildcard ships no Linux server.",
  "platforms": [
    "windows"
  ],
  "defaultMemory": 16384,
  "variables": [
    {
      "name": "MAP",
      "label": "Map",
      "default": "TheIsland_WP",
      "options": [
        "TheIsland_WP",
        "ScorchedEarth_WP",
        "TheCenter_WP",
        "Aberration_WP",
        "Extinction_WP",
        "Ragnarok_WP"
      ],
      "allowCustom": true
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "default": 70,
      "type": "number"
    },
    {
      "name": "SERVER_PASSWORD",
      "label": "Join password",
      "default": "",
      "description": "Leave empty for an open server."
    },
    {
      "name": "RCON_PASSWORD",
      "label": "Admin and RCON password",
      "default": "",
      "generate": "password"
    },
    {
      "name": "XP_MULTIPLIER",
      "label": "XP multiplier",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "HARVEST_MULTIPLIER",
      "label": "Harvest amount multiplier",
      "type": "number",
      "default": 1,
      "description": "How much each hit on a tree or rock gives.",
      "group": "Rates"
    },
    {
      "name": "TAMING_MULTIPLIER",
      "label": "Taming speed multiplier",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "MATING_INTERVAL_MULTIPLIER",
      "label": "Mating interval multiplier",
      "type": "number",
      "default": 1,
      "description": "Lower is faster. 0.5 halves the wait.",
      "group": "Rates"
    },
    {
      "name": "EGG_HATCH_MULTIPLIER",
      "label": "Egg hatch speed multiplier",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "BABY_MATURE_MULTIPLIER",
      "label": "Baby growth speed multiplier",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "DAY_CYCLE_SCALE",
      "label": "Day cycle speed",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "DIFFICULTY_OFFSET",
      "label": "Difficulty (0 to 1)",
      "type": "number",
      "default": 1,
      "description": "1 spawns the highest-level wild creatures.",
      "group": "Rules"
    },
    {
      "name": "SERVER_PVE",
      "label": "PvE (players cannot hurt each other)",
      "default": "False",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "SERVER_HARDCORE",
      "label": "Hardcore (lose your character on death)",
      "default": "False",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "THIRD_PERSON",
      "label": "Third person",
      "default": "True",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "MAP_PLAYER_LOCATION",
      "label": "Show your position on the map",
      "default": "False",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "CROSSHAIR",
      "label": "Crosshair",
      "default": "True",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "rcon",
      "default": 27020,
      "protocol": "tcp",
      "offset": 19243
    }
  ],
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "2430930",
        "label": "Install the ARK: Survival Ascended server (about 13 GB)"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      },
      {
        "type": "directx",
        "label": "Install the DirectX runtime"
      }
    ]
  },
  "startCommand": "ShooterGame\\Binaries\\Win64\\ArkAscendedServer.exe {{MAP}}?listen?SessionName=\"{{SERVER_NAME}}\"?Port={{PORT}}?RCONEnabled=True?RCONPort={{PORT_RCON}}?ServerPassword={{SERVER_PASSWORD}}?ServerAdminPassword={{RCON_PASSWORD}} -WinLiveMaxPlayers={{MAX_PLAYERS}} -log",
  "tailFiles": [
    "ShooterGame/Saved/Logs/ShooterGame.log"
  ],
  "consoleInput": false,
  "rcon": {
    "type": "source",
    "port": "rcon"
  },
  "stopRconCommand": "DoExit",
  "stopTimeout": 120,
  "query": {
    "type": "none"
  },
  "readyOnPort": "game",
  "logPatterns": {
    "ready": "has completed startup|advertising for join",
    "join": "([^ ]+) joined this ARK",
    "leave": "([^ ]+) left this ARK"
  },
  "ci": {
    "bootTimeout": 1800
  },
  "patchProperties": [
    {
      "path": "ShooterGame/Saved/Config/WindowsServer/GameUserSettings.ini",
      "format": "ini",
      "section": "ServerSettings",
      "createIfMissing": true,
      "set": {
        "XPMultiplier": "{{XP_MULTIPLIER}}",
        "HarvestAmountMultiplier": "{{HARVEST_MULTIPLIER}}",
        "TamingSpeedMultiplier": "{{TAMING_MULTIPLIER}}",
        "MatingIntervalMultiplier": "{{MATING_INTERVAL_MULTIPLIER}}",
        "EggHatchSpeedMultiplier": "{{EGG_HATCH_MULTIPLIER}}",
        "BabyMatureSpeedMultiplier": "{{BABY_MATURE_MULTIPLIER}}",
        "DayCycleSpeedScale": "{{DAY_CYCLE_SCALE}}",
        "DifficultyOffset": "{{DIFFICULTY_OFFSET}}",
        "ServerPVE": "{{SERVER_PVE}}",
        "ServerHardcore": "{{SERVER_HARDCORE}}",
        "AllowThirdPersonPlayer": "{{THIRD_PERSON}}",
        "ShowMapPlayerLocation": "{{MAP_PLAYER_LOCATION}}",
        "ServerCrosshair": "{{CROSSHAIR}}"
      }
    }
  ]
}
