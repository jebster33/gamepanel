{
  "id": "satisfactory",
  "name": "Satisfactory",
  "category": "Sandbox",
  "icon": "🏭",
  "description": "Satisfactory dedicated server. After the first start, claim the server from the in-game server manager (Server Manager → Add Server).",
  "defaultMemory": 8192,
  "variables": [
    {
      "name": "BETA_BRANCH",
      "label": "Steam branch",
      "default": "",
      "description": "Experimental tracks the newest game build.",
      "options": [
        {
          "value": "",
          "label": "Release (stable)"
        },
        {
          "value": "experimental",
          "label": "Experimental"
        }
      ]
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "type": "number",
      "default": 4
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "both"
    }
  ],
  "install": [
    {
      "type": "steamcmd",
      "appid": "1690800",
      "branch": "{{BETA_BRANCH}}",
      "label": "Install Satisfactory dedicated server"
    },
    {
      "type": "chmod",
      "path": "FactoryServer.sh",
      "mode": "+x"
    }
  ],
  "startCommand": "./FactoryServer.sh -Port={{PORT}} -log -unattended",
  "stopTimeout": 60,
  "query": {
    "type": "udp",
    "port": "game"
  },
  "logPatterns": {
    "ready": "Server is ready|Game state is now|SocketSubsystem"
  },
  "image": "cm2network/steamcmd:root"
}
