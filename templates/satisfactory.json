{
  "id": "satisfactory",
  "name": "Satisfactory",
  "category": "Sandbox",
  "icon": "🏭",
  "description": "Satisfactory dedicated server. After the first start, claim the server from the in-game server manager.",
  "defaultMemory": 8192,
  "variables": [
    {
      "name": "BETA_BRANCH",
      "label": "Steam branch",
      "default": "",
      "description": "Leave empty for the release build, or use 'experimental'."
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "type": "number",
      "default": 4
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "reliable",
      "default": 8888,
      "protocol": "tcp"
    }
  ],
  "install": [
    {
      "type": "steamcmd",
      "appid": "1690800",
      "branch": "{{BETA_BRANCH}}",
      "label": "Install Satisfactory dedicated server"
    },
    {
      "type": "chmod",
      "path": "FactoryServer.sh",
      "mode": "+x"
    }
  ],
  "startCommand": "./FactoryServer.sh -ServerQueryPort={{PORT}} -BeaconPort={{PORT}} -Port={{PORT}} -ReliablePort={{PORT_RELIABLE}} -multihome=0.0.0.0 -unattended",
  "stopTimeout": 60,
  "query": {
    "type": "udp",
    "port": "game"
  },
  "logPatterns": {
    "ready": "Server is ready|Game state is now"
  },
  "image": "cm2network/steamcmd:root"
}
