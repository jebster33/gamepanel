{
  "id": "no-more-room-in-hell",
  "name": "No More Room in Hell",
  "category": "Shooter",
  "icon": "🧟",
  "storeAppId": 224260,
  "description": "Free co-op zombie survival on the Source engine. nmo_ maps are objective, nms_ maps are survival.",
  "platforms": [
    "linux",
    "windows"
  ],
  "defaultMemory": 2048,
  "variables": [
    {
      "name": "MAP",
      "label": "Starting map",
      "default": "nmo_broadway",
      "options": [
        "nmo_broadway",
        "nmo_chinatown",
        "nmo_junction",
        "nmo_toxteth",
        "nmo_cabin",
        "nmo_brooklyn",
        "nmo_lakeside",
        "nms_isolated",
        "nms_campblood",
        "nms_arpley"
      ],
      "allowCustom": true
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "default": 8,
      "type": "number"
    },
    {
      "name": "GSLT",
      "label": "Steam game server token (GSLT)",
      "default": "",
      "description": "Optional. Lists the server publicly; get one at steamcommunity.com/dev/managegameservers."
    },
    {
      "name": "RCON_PASSWORD",
      "label": "RCON password",
      "default": "",
      "generate": "password"
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "tv",
      "default": 27020,
      "protocol": "udp",
      "offset": 5
    }
  ],
  "image": "cm2network/steamcmd:root",
  "install": [
    {
      "type": "steamcmd",
      "appid": "317670",
      "label": "Install the No More Room in Hell dedicated server"
    },
    {
      "type": "chmod",
      "path": "srcds_run",
      "mode": "+x"
    }
  ],
  "configFiles": [
    {
      "path": "nmrih/cfg/server.cfg",
      "mode": "create",
      "content": "hostname \"{{SERVER_NAME}}\"\nrcon_password \"{{RCON_PASSWORD}}\"\nsv_lan 0\n"
    }
  ],
  "startCommand": "./srcds_run -console -norestart -game nmrih -port {{PORT}} +maxplayers {{MAX_PLAYERS}} +tv_port {{PORT_TV}} +map {{MAP}} +sv_setsteamaccount \"{{GSLT}}\"",
  "stopCommand": "quit",
  "stopTimeout": 45,
  "query": {
    "type": "a2s",
    "port": "game"
  },
  "rcon": {
    "type": "source",
    "port": "game"
  },
  "logPatterns": {
    "ready": "VAC secure mode|gameserver Steam ID|Connection to Steam servers successful",
    "join": "\"([^<]+)<[0-9]+><[^>]*><>\" entered the game",
    "leave": "\"([^<]+)<[0-9]+><[^>]*><[^>]*>\" disconnected"
  },
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "317670",
        "label": "Install the No More Room in Hell dedicated server"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      }
    ],
    "startCommand": "srcds.exe -console -nocrashdialog -condebug -game nmrih -port {{PORT}} +maxplayers {{MAX_PLAYERS}} +tv_port {{PORT_TV}} +map {{MAP}} +sv_setsteamaccount \"{{GSLT}}\"",
    "tailFiles": [
      "nmrih/console.log"
    ],
    "consoleInput": false,
    "stopCommand": null,
    "stopRconCommand": "quit"
  },
  "pty": true
}
