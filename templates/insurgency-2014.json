{
  "id": "insurgency-2014",
  "name": "Insurgency (2014)",
  "category": "Shooter",
  "icon": "🎖️",
  "storeAppId": 222880,
  "description": "New World Interactive's tactical shooter on the Source engine (the 2014 original, not Sandstorm).",
  "platforms": [
    "linux",
    "windows"
  ],
  "defaultMemory": 2048,
  "variables": [
    {
      "name": "MAP",
      "label": "Starting map",
      "default": "ministry",
      "options": [
        "ministry",
        "market",
        "siege",
        "panj",
        "contact",
        "district",
        "heights",
        "peak",
        "sinjar",
        "uprising",
        "buhriz",
        "verticality"
      ],
      "allowCustom": true
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "default": 32,
      "type": "number"
    },
    {
      "name": "PLAYLIST",
      "label": "Playlist (game mode)",
      "default": "nwi/pvp_sustained",
      "options": [
        "nwi/pvp_sustained",
        "nwi/pvp_push",
        "nwi/pvp_firefight",
        "nwi/coop",
        "nwi/coop_hunt"
      ],
      "allowCustom": true
    },
    {
      "name": "GSLT",
      "label": "Steam game server token (GSLT)",
      "default": "",
      "description": "Optional. Lists the server publicly; get one at steamcommunity.com/dev/managegameservers."
    },
    {
      "name": "RCON_PASSWORD",
      "label": "RCON password",
      "default": "",
      "generate": "password"
    },
    {
      "name": "FRIENDLY_FIRE",
      "label": "Friendly fire",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "description": "Teammates can hurt each other.",
      "group": "Rules"
    },
    {
      "name": "TIME_LIMIT",
      "label": "Time limit per map (minutes)",
      "type": "number",
      "default": "",
      "description": "0 means no limit. Blank keeps the game default.",
      "group": "Rules"
    },
    {
      "name": "ALLTALK",
      "label": "Everyone can hear everyone",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "description": "Dead players and the other team hear voice chat too.",
      "group": "Rules"
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "tv",
      "default": 27020,
      "protocol": "udp",
      "offset": 5
    }
  ],
  "image": "cm2network/steamcmd:root",
  "install": [
    {
      "type": "steamcmd",
      "appid": "237410",
      "label": "Install the Insurgency (2014) dedicated server"
    },
    {
      "type": "chmod",
      "path": "srcds_run",
      "mode": "+x"
    }
  ],
  "configFiles": [
    {
      "path": "insurgency/cfg/server.cfg",
      "mode": "create",
      "content": "hostname \"{{SERVER_NAME}}\"\nrcon_password \"{{RCON_PASSWORD}}\"\nsv_lan 0\n"
    },
    {
      "path": "insurgency/cfg/gamepanel-rules.cfg",
      "mode": "overwrite",
      "content": "// Written by GamePanel from the game settings. A blank value leaves the game default alone.\nmp_friendlyfire {{FRIENDLY_FIRE}}\nmp_timelimit {{TIME_LIMIT}}\nsv_alltalk {{ALLTALK}}\n"
    }
  ],
  "startCommand": "./srcds_run -console -norestart -game insurgency -port {{PORT}} -maxplayers {{MAX_PLAYERS}} +tv_port {{PORT_TV}} +sv_playlist {{PLAYLIST}} +map {{MAP}} +sv_setsteamaccount \"{{GSLT}}\" +exec gamepanel-rules.cfg",
  "stopCommand": "quit",
  "stopTimeout": 45,
  "query": {
    "type": "a2s",
    "port": "game"
  },
  "rcon": {
    "type": "source",
    "port": "game"
  },
  "logPatterns": {
    "ready": "VAC secure mode|gameserver Steam ID|Connection to Steam servers successful",
    "join": "\"([^<]+)<[0-9]+><[^>]*><>\" entered the game",
    "leave": "\"([^<]+)<[0-9]+><[^>]*><[^>]*>\" disconnected"
  },
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "237410",
        "label": "Install the Insurgency (2014) dedicated server"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      }
    ],
    "startCommand": "srcds.exe -console -nocrashdialog -condebug -game insurgency -port {{PORT}} -maxplayers {{MAX_PLAYERS}} +tv_port {{PORT_TV}} +sv_playlist {{PLAYLIST}} +map {{MAP}} +sv_setsteamaccount \"{{GSLT}}\" +exec gamepanel-rules.cfg",
    "tailFiles": [
      "insurgency/console.log"
    ],
    "consoleInput": false,
    "stopCommand": null,
    "stopRconCommand": "quit"
  },
  "pty": true
}
