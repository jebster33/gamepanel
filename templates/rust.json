{
  "id": "rust",
  "name": "Rust",
  "category": "Survival",
  "icon": "🔩",
  "storeAppId": 252490,
  "description": "Facepunch's Rust dedicated server. Expect a large install (~15 GB) and heavy RAM use.",
  "defaultMemory": 8192,
  "variables": [
    {
      "name": "SERVER_HOSTNAME",
      "label": "Server name",
      "default": "A GamePanel Rust server"
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "type": "number",
      "default": 50
    },
    {
      "name": "WORLD_SIZE",
      "label": "World size",
      "type": "number",
      "default": 3500
    },
    {
      "name": "WORLD_SEED",
      "label": "World seed",
      "type": "number",
      "default": 1337
    },
    {
      "name": "SERVER_DESCRIPTION",
      "label": "Description",
      "default": "Powered by GamePanel"
    },
    {
      "name": "RCON_PASSWORD",
      "label": "RCON password",
      "generate": "password",
      "default": ""
    },
    {
      "name": "INSTALL_OXIDE",
      "label": "Install uMod/Oxide (plugin support)",
      "default": "true",
      "options": [
        {
          "value": "true",
          "label": "Yes — install uMod/Oxide for plugins"
        },
        {
          "value": "false",
          "label": "No — vanilla Rust"
        }
      ],
      "description": "Required for the plugin browser. Note that Oxide/uMod servers cannot join the official server list."
    },
    {
      "name": "GAME_MODE",
      "label": "Game mode",
      "default": "vanilla",
      "options": [
        {
          "value": "vanilla",
          "label": "Normal (vanilla)"
        },
        {
          "value": "softcore",
          "label": "Softcore"
        },
        {
          "value": "hardcore",
          "label": "Hardcore"
        }
      ],
      "description": "Vanilla is the standard game. Softcore is gentler on death and progression, hardcore is harsher.",
      "group": "Rules"
    },
    {
      "name": "SERVER_PVE",
      "label": "PvE (players cannot hurt each other)",
      "default": "false",
      "options": [
        {
          "value": "true",
          "label": "Yes"
        },
        {
          "value": "false",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "MAP_LEVEL",
      "label": "Map",
      "default": "Procedural Map",
      "options": [
        {
          "value": "Procedural Map",
          "label": "Procedural Map"
        },
        {
          "value": "Barren",
          "label": "Barren"
        },
        {
          "value": "HapisIsland",
          "label": "HapisIsland"
        },
        {
          "value": "CraggyIsland",
          "label": "CraggyIsland"
        },
        {
          "value": "SavasIsland",
          "label": "SavasIsland"
        },
        {
          "value": "SavasIsland_koth",
          "label": "SavasIsland_koth"
        }
      ],
      "description": "Procedural uses the world size and seed above. The others are the fixed maps that ship with the game.",
      "group": "World"
    },
    {
      "name": "DECAY_SCALE",
      "label": "Base decay speed",
      "type": "number",
      "default": 1,
      "description": "1 is normal, 0 turns decay off, 2 doubles it.",
      "group": "Rules"
    },
    {
      "name": "RADIATION",
      "label": "Radiation",
      "default": "true",
      "options": [
        {
          "value": "true",
          "label": "Yes"
        },
        {
          "value": "false",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "MAX_TEAM",
      "label": "Max team size",
      "type": "number",
      "default": 8,
      "description": "0 lets teams be any size.",
      "group": "Rules"
    },
    {
      "name": "SAVE_INTERVAL",
      "label": "Save every (seconds)",
      "type": "number",
      "default": 300,
      "group": "Rules"
    },
    {
      "name": "SERVER_TAGS",
      "label": "Server tags",
      "default": "",
      "description": "Comma separated, e.g. monthly,vanilla,EU. Helps players find the server in the browser.",
      "group": "Listing"
    },
    {
      "name": "SERVER_URL",
      "label": "Website link",
      "default": "",
      "description": "Shown on the server page in the game.",
      "group": "Listing"
    },
    {
      "name": "HEADER_IMAGE",
      "label": "Header image URL",
      "default": "",
      "description": "A 512x256 image shown on the server page.",
      "group": "Listing"
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 28015,
      "protocol": "udp"
    },
    {
      "name": "rcon",
      "default": 28016,
      "protocol": "tcp",
      "offset": 1
    },
    {
      "name": "query",
      "default": 28017,
      "protocol": "udp",
      "offset": 2
    },
    {
      "name": "app",
      "default": 28082,
      "protocol": "tcp",
      "offset": 67
    }
  ],
  "install": [
    {
      "type": "steamcmd",
      "appid": "258550",
      "label": "Install Rust dedicated server (this takes a while)"
    },
    {
      "type": "mkdir",
      "path": "server/gamepanel"
    },
    {
      "type": "script",
      "label": "Install uMod / Oxide",
      "run": "if [ \"{{INSTALL_OXIDE}}\" = \"true\" ]; then\n  gp_fetch \"https://github.com/OxideMod/Oxide.Rust/releases/latest/download/Oxide.Rust-linux.zip\" oxide.zip\n  gp_extract oxide.zip .\n  rm -f oxide.zip\n  mkdir -p oxide/plugins oxide/config oxide/data\n  gp_log \"Oxide installed — plugins go in oxide/plugins\"\nelse\n  gp_log \"Skipping Oxide (vanilla Rust)\"\nfi"
    }
  ],
  "startCommand": "./RustDedicated -batchmode -nographics +server.identity gamepanel +server.ip 0.0.0.0 +server.port {{PORT}} +server.queryport {{PORT_QUERY}} +rcon.ip 0.0.0.0 +rcon.port {{PORT_RCON}} +rcon.password \"{{RCON_PASSWORD}}\" +rcon.web 1 +app.port {{PORT_APP}} +server.maxplayers {{MAX_PLAYERS}} +server.hostname \"{{SERVER_HOSTNAME}}\" +server.description \"{{SERVER_DESCRIPTION}}\" +server.worldsize {{WORLD_SIZE}} +server.seed {{WORLD_SEED}} +server.saveinterval {{SAVE_INTERVAL}} +server.gamemode {{GAME_MODE}} +server.pve {{SERVER_PVE}} +server.level \"{{MAP_LEVEL}}\" +decay.scale {{DECAY_SCALE}} +server.radiation {{RADIATION}} +relationshipmanager.maxteamsize {{MAX_TEAM}} +server.tags \"{{SERVER_TAGS}}\" +server.url \"{{SERVER_URL}}\" +server.headerimage \"{{HEADER_IMAGE}}\"",
  "stopCommand": "quit",
  "stopTimeout": 120,
  "query": {
    "type": "a2s",
    "port": "query"
  },
  "rcon": {
    "type": "source",
    "port": "rcon"
  },
  "logPatterns": {
    "ready": "Server startup complete",
    "join": "([A-Za-z0-9_.\\- ]+)\\[[0-9]+/[0-9]+\\] has entered the game",
    "leave": "([A-Za-z0-9_.\\- ]+)\\[[0-9]+/[0-9]+\\] disconnecting"
  },
  "image": "cm2network/steamcmd:root",
  "mods": {
    "providers": [
      "umod"
    ],
    "dir": "oxide/plugins",
    "game": "rust"
  },
  "platforms": [
    "linux",
    "windows"
  ],
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "258550",
        "label": "Install Rust dedicated server (this takes a while)"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      },
      {
        "type": "mkdir",
        "path": "server/gamepanel"
      },
      {
        "type": "powershell",
        "label": "Install uMod / Oxide",
        "run": "if ('{{INSTALL_OXIDE}}' -eq 'true') {\n  GP-Fetch 'https://github.com/OxideMod/Oxide.Rust/releases/latest/download/Oxide.Rust.zip' 'oxide.zip'\n  GP-Extract 'oxide.zip' '.'\n  Remove-Item oxide.zip\n  foreach ($d in 'oxide/plugins','oxide/config','oxide/data') { New-Item -ItemType Directory -Force $d | Out-Null }\n  GP-Log 'Oxide installed. Plugins go in oxide/plugins'\n} else { GP-Log 'Skipping Oxide (vanilla Rust)' }"
      }
    ],
    "startCommand": "RustDedicated.exe -batchmode -nographics +server.identity gamepanel +server.ip 0.0.0.0 +server.port {{PORT}} +server.queryport {{PORT_QUERY}} +rcon.ip 0.0.0.0 +rcon.port {{PORT_RCON}} +rcon.password \"{{RCON_PASSWORD}}\" +rcon.web 1 +app.port {{PORT_APP}} +server.maxplayers {{MAX_PLAYERS}} +server.hostname \"{{SERVER_HOSTNAME}}\" +server.description \"{{SERVER_DESCRIPTION}}\" +server.worldsize {{WORLD_SIZE}} +server.seed {{WORLD_SEED}} +server.saveinterval {{SAVE_INTERVAL}} +server.gamemode {{GAME_MODE}} +server.pve {{SERVER_PVE}} +server.level \"{{MAP_LEVEL}}\" +decay.scale {{DECAY_SCALE}} +server.radiation {{RADIATION}} +relationshipmanager.maxteamsize {{MAX_TEAM}} +server.tags \"{{SERVER_TAGS}}\" +server.url \"{{SERVER_URL}}\" +server.headerimage \"{{HEADER_IMAGE}}\" -logfile \"logs/rust.log\"",
    "tailFiles": [
      "logs/rust.log"
    ],
    "consoleInput": false,
    "stopCommand": null,
    "stopRconCommand": "quit"
  },
  "wipe": {
    "dir": "server/gamepanel",
    "map": [
      "*.map",
      "*.sav",
      "*.sav.*",
      "player.states.*.db",
      "sv.files.*.db"
    ],
    "blueprints": [
      "player.blueprints.*.db"
    ],
    "seedVar": "WORLD_SEED"
  }
}
