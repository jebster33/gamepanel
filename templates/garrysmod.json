{
  "id": "garrysmod",
  "name": "Garry's Mod",
  "category": "Sandbox",
  "icon": "🔧",
  "storeAppId": 4000,
  "description": "Garry's Mod dedicated server with Workshop collection support.",
  "defaultMemory": 4096,
  "variables": [
    {
      "name": "GAMEMODE",
      "label": "Gamemode",
      "default": "sandbox",
      "options": [
        {
          "value": "sandbox",
          "label": "Sandbox"
        },
        {
          "value": "darkrp",
          "label": "DarkRP (needs the addon)"
        },
        {
          "value": "terrortown",
          "label": "Trouble in Terrorist Town (needs the addon)"
        },
        {
          "value": "prop_hunt",
          "label": "Prop Hunt (needs the addon)"
        },
        {
          "value": "murder",
          "label": "Murder (needs the addon)"
        }
      ],
      "allowCustom": true,
      "description": "Gamemodes other than Sandbox need their addon installed first."
    },
    {
      "name": "MAP",
      "label": "Starting map",
      "default": "gm_construct",
      "options": [
        "gm_construct",
        "gm_flatgrass",
        "gm_bigcity",
        "rp_downtown_v4c_v2",
        "ttt_minecraft_b5"
      ],
      "allowCustom": true,
      "description": "Only maps present on the server will load — Workshop maps arrive with your collection."
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "type": "number",
      "default": 16
    },
    {
      "name": "WORKSHOP_COLLECTION",
      "label": "Workshop collection ID",
      "default": ""
    },
    {
      "name": "GSLT",
      "label": "Steam game server token (GSLT)",
      "default": ""
    },
    {
      "name": "RCON_PASSWORD",
      "label": "RCON password",
      "generate": "password",
      "default": ""
    },
    {
      "name": "SBOX_NOCLIP",
      "label": "Noclip",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "SBOX_GODMODE",
      "label": "God mode",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "description": "Players take no damage.",
      "group": "Rules"
    },
    {
      "name": "SBOX_PLAYERS_HURT",
      "label": "Players can hurt each other",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "SBOX_MAXPROPS",
      "label": "Props per player",
      "type": "number",
      "default": "",
      "description": "Blank keeps the game default.",
      "group": "Rules"
    },
    {
      "name": "ALLTALK",
      "label": "Everyone can hear everyone",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "description": "Dead players and the other team hear voice chat too.",
      "group": "Rules"
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    }
  ],
  "install": [
    {
      "type": "steamcmd",
      "appid": "4020",
      "label": "Install Garry's Mod dedicated server"
    },
    {
      "type": "chmod",
      "path": "srcds_run",
      "mode": "+x"
    }
  ],
  "configFiles": [
    {
      "path": "garrysmod/cfg/server.cfg",
      "mode": "create",
      "content": "hostname \"{{SERVER_NAME}}\"\nrcon_password \"{{RCON_PASSWORD}}\"\nsv_lan 0\nsv_region 255\n"
    },
    {
      "path": "garrysmod/cfg/gamepanel-rules.cfg",
      "mode": "overwrite",
      "content": "// Written by GamePanel from the game settings. A blank value leaves the game default alone.\nsbox_noclip {{SBOX_NOCLIP}}\nsbox_godmode {{SBOX_GODMODE}}\nsbox_playershurtplayers {{SBOX_PLAYERS_HURT}}\nsbox_maxprops {{SBOX_MAXPROPS}}\nsv_alltalk {{ALLTALK}}\n"
    }
  ],
  "startCommand": "./srcds_run -game garrysmod -console -norestart -port {{PORT}} +maxplayers {{MAX_PLAYERS}} +gamemode {{GAMEMODE}} +map {{MAP}} +host_workshop_collection {{WORKSHOP_COLLECTION}} +sv_setsteamaccount \"{{GSLT}}\" +exec gamepanel-rules.cfg",
  "stopCommand": "quit",
  "stopTimeout": 45,
  "query": {
    "type": "a2s",
    "port": "game"
  },
  "rcon": {
    "type": "source",
    "port": "game"
  },
  "logPatterns": {
    "ready": "gameserver Steam ID|VAC secure mode|Using map cycle file",
    "join": "Client \"([^\"]+)\" connected",
    "leave": "Dropped ([^ ]+) from server"
  },
  "image": "cm2network/steamcmd:root",
  "mods": {
    "providers": [
      "workshop"
    ],
    "dir": "garrysmod/addons",
    "appId": 4000,
    "workshop": {
      "strategy": "gma"
    }
  },
  "platforms": [
    "linux",
    "windows"
  ],
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "4020",
        "label": "Install Garry's Mod dedicated server"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      }
    ],
    "startCommand": "srcds.exe -console -nocrashdialog -condebug -game garrysmod -port {{PORT}} +maxplayers {{MAX_PLAYERS}} +gamemode {{GAMEMODE}} +map {{MAP}} +host_workshop_collection {{WORKSHOP_COLLECTION}} +sv_setsteamaccount \"{{GSLT}}\" +exec gamepanel-rules.cfg",
    "tailFiles": [
      "garrysmod/console.log"
    ],
    "consoleInput": false,
    "stopCommand": null,
    "stopRconCommand": "quit"
  },
  "pty": true
}
