{
  "id": "garrysmod",
  "name": "Garry's Mod",
  "category": "Sandbox",
  "icon": "🔧",
  "description": "Garry's Mod dedicated server with Workshop collection support.",
  "defaultMemory": 4096,
  "variables": [
    {
      "name": "GAMEMODE",
      "label": "Gamemode",
      "default": "sandbox",
      "options": [
        {
          "value": "sandbox",
          "label": "Sandbox"
        },
        {
          "value": "darkrp",
          "label": "DarkRP (needs the addon)"
        },
        {
          "value": "terrortown",
          "label": "Trouble in Terrorist Town (needs the addon)"
        },
        {
          "value": "prop_hunt",
          "label": "Prop Hunt (needs the addon)"
        },
        {
          "value": "murder",
          "label": "Murder (needs the addon)"
        }
      ],
      "allowCustom": true,
      "description": "Gamemodes other than Sandbox need their addon installed first."
    },
    {
      "name": "MAP",
      "label": "Starting map",
      "default": "gm_construct",
      "options": [
        "gm_construct",
        "gm_flatgrass",
        "gm_bigcity",
        "rp_downtown_v4c_v2",
        "ttt_minecraft_b5"
      ],
      "allowCustom": true,
      "description": "Only maps present on the server will load — Workshop maps arrive with your collection."
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "type": "number",
      "default": 16
    },
    {
      "name": "WORKSHOP_COLLECTION",
      "label": "Workshop collection ID",
      "default": ""
    },
    {
      "name": "GSLT",
      "label": "Steam game server token (GSLT)",
      "default": ""
    },
    {
      "name": "RCON_PASSWORD",
      "label": "RCON password",
      "generate": "password",
      "default": ""
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    }
  ],
  "install": [
    {
      "type": "steamcmd",
      "appid": "4020",
      "label": "Install Garry's Mod dedicated server"
    },
    {
      "type": "chmod",
      "path": "srcds_run",
      "mode": "+x"
    }
  ],
  "configFiles": [
    {
      "path": "garrysmod/cfg/server.cfg",
      "mode": "create",
      "content": "hostname \"{{SERVER_NAME}}\"\nrcon_password \"{{RCON_PASSWORD}}\"\nsv_lan 0\nsv_region 255\n"
    }
  ],
  "startCommand": "./srcds_run -game garrysmod -console -norestart -port {{PORT}} +maxplayers {{MAX_PLAYERS}} +gamemode {{GAMEMODE}} +map {{MAP}} +host_workshop_collection {{WORKSHOP_COLLECTION}} +sv_setsteamaccount \"{{GSLT}}\"",
  "stopCommand": "quit",
  "stopTimeout": 45,
  "query": {
    "type": "a2s",
    "port": "game"
  },
  "rcon": {
    "type": "source",
    "port": "game"
  },
  "logPatterns": {
    "ready": "gameserver Steam ID|VAC secure mode",
    "join": "Client \"([^\"]+)\" connected",
    "leave": "Dropped ([^ ]+) from server"
  },
  "image": "cm2network/steamcmd:root",
  "mods": {
    "providers": [
      "workshop"
    ],
    "dir": "garrysmod/addons",
    "appId": 4020
  }
}
