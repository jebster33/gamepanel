{
  "id": "palworld",
  "name": "Palworld",
  "category": "Survival",
  "icon": "🐾",
  "storeAppId": 1623730,
  "description": "Palworld dedicated server. Needs plenty of RAM — 16 GB is comfortable for a full 32-player world.",
  "defaultMemory": 12288,
  "variables": [
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "type": "number",
      "default": 16
    },
    {
      "name": "SERVER_PASSWORD",
      "label": "Join password",
      "default": ""
    },
    {
      "name": "ADMIN_PASSWORD",
      "label": "Admin password",
      "generate": "password",
      "default": ""
    },
    {
      "name": "RCON_PASSWORD",
      "label": "RCON password",
      "generate": "password",
      "default": ""
    },
    {
      "name": "PUBLIC_IP",
      "label": "Public IP (optional)",
      "default": ""
    },
    {
      "name": "PAL_DIFFICULTY",
      "label": "Difficulty",
      "default": "None",
      "options": [
        {
          "value": "None",
          "label": "Normal"
        },
        {
          "value": "Casual",
          "label": "Casual"
        },
        {
          "value": "Hard",
          "label": "Hard"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "EXP_RATE",
      "label": "XP rate",
      "type": "number",
      "default": 1,
      "description": "1 is normal, 2 doubles the XP.",
      "group": "Rates"
    },
    {
      "name": "CAPTURE_RATE",
      "label": "Pal capture rate",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "SPAWN_RATE",
      "label": "Pal spawn rate",
      "type": "number",
      "default": 1,
      "description": "Lower it if the server struggles.",
      "group": "Rates"
    },
    {
      "name": "EGG_HATCH_HOURS",
      "label": "Egg hatch time (hours)",
      "type": "number",
      "default": 72,
      "description": "0 hatches eggs instantly.",
      "group": "Rates"
    },
    {
      "name": "DAY_SPEED",
      "label": "Day speed",
      "type": "number",
      "default": 1,
      "group": "Time"
    },
    {
      "name": "NIGHT_SPEED",
      "label": "Night speed",
      "type": "number",
      "default": 1,
      "group": "Time"
    },
    {
      "name": "DEATH_PENALTY",
      "label": "On death",
      "default": "All",
      "options": [
        {
          "value": "None",
          "label": "Drop nothing"
        },
        {
          "value": "Item",
          "label": "Drop items"
        },
        {
          "value": "ItemAndEquipment",
          "label": "Drop items and equipment"
        },
        {
          "value": "All",
          "label": "Drop everything, including Pals"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "PVP",
      "label": "PvP",
      "default": "False",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "RAIDS",
      "label": "Base raids",
      "default": "True",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "description": "Enemies that attack player bases.",
      "group": "Rules"
    },
    {
      "name": "HARDCORE",
      "label": "Hardcore (characters die for good)",
      "default": "False",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 8211,
      "protocol": "udp"
    },
    {
      "name": "rcon",
      "default": 25575,
      "protocol": "tcp"
    },
    {
      "name": "query",
      "default": 27015,
      "protocol": "udp"
    }
  ],
  "install": [
    {
      "type": "steamcmd",
      "appid": "2394010",
      "label": "Install Palworld dedicated server"
    },
    {
      "type": "chmod",
      "path": "PalServer.sh",
      "mode": "+x"
    },
    {
      "type": "script",
      "label": "Seed the default configuration",
      "run": "mkdir -p Pal/Saved/Config/LinuxServer\nif [ ! -f Pal/Saved/Config/LinuxServer/PalWorldSettings.ini ] && [ -f DefaultPalWorldSettings.ini ]; then\n  cp DefaultPalWorldSettings.ini Pal/Saved/Config/LinuxServer/PalWorldSettings.ini\nfi"
    }
  ],
  "startCommand": "./PalServer.sh -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS -port={{PORT}} -queryport={{PORT_QUERY}} -players={{MAX_PLAYERS}} -RconEnabled=True -RconPort={{PORT_RCON}} -AdminPassword=\"{{ADMIN_PASSWORD}}\" -ServerPassword=\"{{SERVER_PASSWORD}}\" -ServerName=\"{{SERVER_NAME}}\"",
  "stopTimeout": 60,
  "query": {
    "type": "a2s",
    "port": "query"
  },
  "rcon": {
    "type": "source",
    "port": "rcon"
  },
  "stopRconCommand": "Shutdown 5",
  "logPatterns": {
    "ready": "Setting breakpad minidump|Running Palworld dedicated server"
  },
  "image": "cm2network/steamcmd:root",
  "platforms": [
    "linux",
    "windows"
  ],
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "2394010",
        "label": "Install Palworld dedicated server"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      },
      {
        "type": "powershell",
        "label": "Create the server settings file",
        "run": "New-Item -ItemType Directory -Force 'Pal/Saved/Config/WindowsServer' | Out-Null\nif (-not (Test-Path 'Pal/Saved/Config/WindowsServer/PalWorldSettings.ini') -and (Test-Path 'DefaultPalWorldSettings.ini')) {\n  Copy-Item 'DefaultPalWorldSettings.ini' 'Pal/Saved/Config/WindowsServer/PalWorldSettings.ini'\n}"
      }
    ],
    "startCommand": "Pal\\Binaries\\Win64\\PalServer-Win64-Shipping-Cmd.exe Pal -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS -port={{PORT}} -queryport={{PORT_QUERY}} -players={{MAX_PLAYERS}} -RconEnabled=True -RconPort={{PORT_RCON}} -AdminPassword=\"{{ADMIN_PASSWORD}}\" -ServerPassword=\"{{SERVER_PASSWORD}}\" -ServerName=\"{{SERVER_NAME}}\"",
    "tailFiles": [
      "Pal/Saved/Logs/Pal.log"
    ],
    "patchProperties": [
      {
        "path": "Pal/Saved/Config/WindowsServer/PalWorldSettings.ini",
        "format": "tuple",
        "key": "OptionSettings",
        "section": "/Script/Pal.PalGameWorldSettings",
        "createIfMissing": true,
        "set": {
          "Difficulty": "{{PAL_DIFFICULTY}}",
          "ExpRate": "{{EXP_RATE}}",
          "PalCaptureRate": "{{CAPTURE_RATE}}",
          "PalSpawnNumRate": "{{SPAWN_RATE}}",
          "PalEggDefaultHatchingTime": "{{EGG_HATCH_HOURS}}",
          "DayTimeSpeedRate": "{{DAY_SPEED}}",
          "NightTimeSpeedRate": "{{NIGHT_SPEED}}",
          "DeathPenalty": "{{DEATH_PENALTY}}",
          "bIsPvP": "{{PVP}}",
          "bEnableInvaderEnemy": "{{RAIDS}}",
          "bHardcore": "{{HARDCORE}}"
        }
      }
    ]
  },
  "patchProperties": [
    {
      "path": "Pal/Saved/Config/LinuxServer/PalWorldSettings.ini",
      "format": "tuple",
      "key": "OptionSettings",
      "section": "/Script/Pal.PalGameWorldSettings",
      "createIfMissing": true,
      "set": {
        "Difficulty": "{{PAL_DIFFICULTY}}",
        "ExpRate": "{{EXP_RATE}}",
        "PalCaptureRate": "{{CAPTURE_RATE}}",
        "PalSpawnNumRate": "{{SPAWN_RATE}}",
        "PalEggDefaultHatchingTime": "{{EGG_HATCH_HOURS}}",
        "DayTimeSpeedRate": "{{DAY_SPEED}}",
        "NightTimeSpeedRate": "{{NIGHT_SPEED}}",
        "DeathPenalty": "{{DEATH_PENALTY}}",
        "bIsPvP": "{{PVP}}",
        "bEnableInvaderEnemy": "{{RAIDS}}",
        "bHardcore": "{{HARDCORE}}"
      }
    }
  ]
}
