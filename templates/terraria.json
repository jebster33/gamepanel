{
  "id": "terraria",
  "name": "Terraria",
  "category": "Sandbox",
  "icon": "🌳",
  "description": "Vanilla Terraria dedicated server. Lightweight — happily runs several worlds on a small VPS.",
  "defaultMemory": 1024,
  "variables": [
    {
      "name": "TERRARIA_BUILD",
      "label": "Terraria build number",
      "default": "latest",
      "description": "Terraria dedicated server build.",
      "source": "terraria-build"
    },
    {
      "name": "WORLD_NAME",
      "label": "World name",
      "default": "World"
    },
    {
      "name": "WORLD_SIZE",
      "label": "World size",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "Small"
        },
        {
          "value": "2",
          "label": "Medium"
        },
        {
          "value": "3",
          "label": "Large"
        }
      ],
      "description": "1 small, 2 medium, 3 large."
    },
    {
      "name": "DIFFICULTY",
      "label": "Difficulty",
      "default": "1",
      "options": [
        {
          "value": "0",
          "label": "Classic"
        },
        {
          "value": "1",
          "label": "Expert"
        },
        {
          "value": "2",
          "label": "Master"
        },
        {
          "value": "3",
          "label": "Journey"
        }
      ]
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "type": "number",
      "default": 8
    },
    {
      "name": "SERVER_PASSWORD",
      "label": "Join password",
      "default": ""
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "tcp"
    }
  ],
  "install": [
    {
      "type": "apt",
      "packages": [
        "unzip"
      ],
      "label": "Install unzip"
    },
    {
      "type": "download",
      "label": "Download Terraria server build {{RESOLVED_BUILD}}",
      "url": "{{DOWNLOAD_URL}}",
      "dest": "terraria.zip"
    },
    {
      "type": "extract",
      "file": "terraria.zip",
      "dest": ".",
      "deleteArchive": true
    },
    {
      "type": "copy",
      "from": "{{RESOLVED_BUILD}}/Linux",
      "to": "."
    },
    {
      "type": "remove",
      "path": "{{RESOLVED_BUILD}}"
    },
    {
      "type": "mkdir",
      "path": "worlds"
    },
    {
      "type": "chmod",
      "path": "TerrariaServer.bin.x86_64",
      "mode": "+x"
    }
  ],
  "configFiles": [
    {
      "path": "serverconfig.txt",
      "mode": "create",
      "content": "world=./worlds/{{WORLD_NAME}}.wld\nautocreate={{WORLD_SIZE}}\ndifficulty={{DIFFICULTY}}\nworldname={{WORLD_NAME}}\nmaxplayers={{MAX_PLAYERS}}\nport={{PORT}}\npassword={{SERVER_PASSWORD}}\nmotd=Welcome to {{SERVER_NAME}}\nsecure=1\nlanguage=en/US\nupnp=0\n"
    }
  ],
  "patchProperties": [
    {
      "path": "serverconfig.txt",
      "format": "properties",
      "createIfMissing": true,
      "set": {
        "port": "{{PORT}}",
        "maxplayers": "{{MAX_PLAYERS}}"
      }
    }
  ],
  "startCommand": "./TerrariaServer.bin.x86_64 -config serverconfig.txt",
  "stopCommand": "exit",
  "stopTimeout": 45,
  "query": {
    "type": "tcp",
    "port": "game"
  },
  "logPatterns": {
    "ready": "Server started",
    "join": "([^ ]+) has joined",
    "leave": "([^ ]+) has left"
  },
  "image": "debian:bookworm-slim",
  "packages": [
    "unzip",
    "curl",
    "ca-certificates"
  ],
  "resolve": "terraria",
  "platforms": [
    "linux",
    "windows"
  ],
  "windows": {
    "install": [
      {
        "type": "download",
        "label": "Download Terraria server build {{RESOLVED_BUILD}}",
        "url": "{{DOWNLOAD_URL}}",
        "dest": "terraria.zip"
      },
      {
        "type": "extract",
        "file": "terraria.zip",
        "dest": ".",
        "deleteArchive": true
      },
      {
        "type": "copy",
        "from": "{{RESOLVED_BUILD}}/Windows",
        "to": "."
      },
      {
        "type": "remove",
        "path": "{{RESOLVED_BUILD}}"
      },
      {
        "type": "mkdir",
        "path": "worlds"
      }
    ],
    "startCommand": "TerrariaServer.exe -config serverconfig.txt"
  }
}
