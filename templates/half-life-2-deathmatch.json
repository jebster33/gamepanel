{
  "id": "half-life-2-deathmatch",
  "name": "Half-Life 2: Deathmatch",
  "category": "Shooter",
  "icon": "🧪",
  "storeAppId": 320,
  "description": "Gravity-gun deathmatch on the Source engine.",
  "platforms": [
    "linux",
    "windows"
  ],
  "defaultMemory": 2048,
  "variables": [
    {
      "name": "MAP",
      "label": "Starting map",
      "default": "dm_lockdown",
      "options": [
        "dm_lockdown",
        "dm_overwatch",
        "dm_powerhouse",
        "dm_resistance",
        "dm_runoff",
        "dm_steamlab",
        "dm_underpass"
      ],
      "allowCustom": true
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "default": 16,
      "type": "number"
    },
    {
      "name": "GSLT",
      "label": "Steam game server token (GSLT)",
      "default": "",
      "description": "Optional. Lists the server publicly; get one at steamcommunity.com/dev/managegameservers."
    },
    {
      "name": "RCON_PASSWORD",
      "label": "RCON password",
      "default": "",
      "generate": "password"
    },
    {
      "name": "FRIENDLY_FIRE",
      "label": "Friendly fire",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "description": "Teammates can hurt each other.",
      "group": "Rules"
    },
    {
      "name": "TIME_LIMIT",
      "label": "Time limit per map (minutes)",
      "type": "number",
      "default": "",
      "description": "0 means no limit. Blank keeps the game default.",
      "group": "Rules"
    },
    {
      "name": "FRAG_LIMIT",
      "label": "Frag limit",
      "type": "number",
      "default": "",
      "description": "0 means no limit.",
      "group": "Rules"
    },
    {
      "name": "TEAMPLAY",
      "label": "Team play",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "ALLTALK",
      "label": "Everyone can hear everyone",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "description": "Dead players and the other team hear voice chat too.",
      "group": "Rules"
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "tv",
      "default": 27020,
      "protocol": "udp",
      "offset": 5
    }
  ],
  "image": "cm2network/steamcmd:root",
  "install": [
    {
      "type": "steamcmd",
      "appid": "232370",
      "label": "Install the Half-Life 2: Deathmatch dedicated server"
    },
    {
      "type": "chmod",
      "path": "srcds_run",
      "mode": "+x"
    }
  ],
  "configFiles": [
    {
      "path": "hl2mp/cfg/server.cfg",
      "mode": "create",
      "content": "hostname \"{{SERVER_NAME}}\"\nrcon_password \"{{RCON_PASSWORD}}\"\nsv_lan 0\n"
    },
    {
      "path": "hl2mp/cfg/gamepanel-rules.cfg",
      "mode": "overwrite",
      "content": "// Written by GamePanel from the game settings. A blank value leaves the game default alone.\nmp_friendlyfire {{FRIENDLY_FIRE}}\nmp_timelimit {{TIME_LIMIT}}\nmp_fraglimit {{FRAG_LIMIT}}\nmp_teamplay {{TEAMPLAY}}\nsv_alltalk {{ALLTALK}}\n"
    }
  ],
  "startCommand": "./srcds_run -console -norestart -game hl2mp -port {{PORT}} +maxplayers {{MAX_PLAYERS}} +tv_port {{PORT_TV}} +map {{MAP}} +sv_setsteamaccount \"{{GSLT}}\" +exec gamepanel-rules.cfg",
  "stopCommand": "quit",
  "stopTimeout": 45,
  "query": {
    "type": "a2s",
    "port": "game"
  },
  "rcon": {
    "type": "source",
    "port": "game"
  },
  "logPatterns": {
    "ready": "VAC secure mode|gameserver Steam ID|Connection to Steam servers successful",
    "join": "\"([^<]+)<[0-9]+><[^>]*><>\" entered the game",
    "leave": "\"([^<]+)<[0-9]+><[^>]*><[^>]*>\" disconnected"
  },
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "232370",
        "label": "Install the Half-Life 2: Deathmatch dedicated server"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      }
    ],
    "startCommand": "srcds.exe -console -nocrashdialog -condebug -game hl2mp -port {{PORT}} +maxplayers {{MAX_PLAYERS}} +tv_port {{PORT_TV}} +map {{MAP}} +sv_setsteamaccount \"{{GSLT}}\" +exec gamepanel-rules.cfg",
    "tailFiles": [
      "hl2mp/console.log"
    ],
    "consoleInput": false,
    "stopCommand": null,
    "stopRconCommand": "quit"
  },
  "pty": true
}
