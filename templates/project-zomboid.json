{
  "id": "project-zomboid",
  "name": "Project Zomboid",
  "category": "Survival",
  "icon": "🧠",
  "storeAppId": 108600,
  "description": "Project Zomboid dedicated server. Console commands work directly from the panel.",
  "defaultMemory": 6144,
  "variables": [
    {
      "name": "ADMIN_PASSWORD",
      "label": "Admin password",
      "generate": "password",
      "default": ""
    },
    {
      "name": "SERVER_PASSWORD",
      "label": "Join password",
      "default": ""
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "type": "number",
      "default": 16
    },
    {
      "name": "SERVER_MEMORY",
      "label": "Java heap (MB)",
      "type": "number",
      "default": 4096
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 16261,
      "protocol": "udp"
    },
    {
      "name": "direct",
      "default": 16262,
      "protocol": "udp",
      "offset": 1
    }
  ],
  "install": [
    {
      "type": "steamcmd",
      "appid": "380870",
      "label": "Install Project Zomboid dedicated server"
    },
    {
      "type": "chmod",
      "path": "start-server.sh",
      "mode": "+x"
    }
  ],
  "configFiles": [
    {
      "path": "Zomboid/Server/servertest.ini",
      "mode": "create",
      "content": "PublicName={{SERVER_NAME}}\nDefaultPort={{PORT}}\nUDPPort={{PORT_DIRECT}}\nMaxPlayers={{MAX_PLAYERS}}\nPassword={{SERVER_PASSWORD}}\nOpen=true\nPVP=true\nPauseEmpty=true\n"
    }
  ],
  "patchProperties": [
    {
      "path": "Zomboid/Server/servertest.ini",
      "format": "properties",
      "createIfMissing": true,
      "set": {
        "DefaultPort": "{{PORT}}",
        "UDPPort": "{{PORT_DIRECT}}",
        "MaxPlayers": "{{MAX_PLAYERS}}"
      }
    }
  ],
  "startCommand": "sed -i -E \"s/-Xmx[0-9]+[mMgG]/-Xmx{{SERVER_MEMORY}}m/\" ProjectZomboid64.json; ZOMBOID_HOME={{SERVER_DIR}}/Zomboid ./start-server.sh -cachedir={{SERVER_DIR}}/Zomboid -adminpassword \"{{ADMIN_PASSWORD}}\" -port {{PORT}}",
  "stopCommand": "quit",
  "stopTimeout": 90,
  "query": {
    "type": "udp",
    "port": "game"
  },
  "logPatterns": {
    "ready": "SERVER STARTED",
    "join": "Fully connected: ([^ ]+)",
    "leave": "Disconnected player \"([^\"]+)\""
  },
  "image": "cm2network/steamcmd:root",
  "platforms": [
    "linux",
    "windows"
  ],
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "380870",
        "label": "Install Project Zomboid dedicated server"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      },
      {
        "type": "powershell",
        "label": "Prepare the start script",
        "run": "# The stock script passes only two arguments on and ends with PAUSE,\n# which would keep a stopped server hanging. Write a copy without both.\n(Get-Content 'StartServer64.bat') -replace '%1 %2', '%*' | Where-Object { $_ -notmatch '^\\s*PAUSE\\s*$' } | Set-Content 'StartServer64-gamepanel.bat'"
      }
    ],
    "startCommand": "StartServer64-gamepanel.bat -cachedir=\"{{SERVER_DIR}}\\Zomboid\" -adminpassword \"{{ADMIN_PASSWORD}}\" -port {{PORT}}"
  },
  "mods": {
    "providers": [
      "workshop"
    ],
    "dir": "Zomboid/mods",
    "appId": 108600,
    "workshop": {
      "strategy": "zomboid",
      "file": "Zomboid/Server/servertest.ini"
    }
  }
}
