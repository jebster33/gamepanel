{
  "id": "necesse",
  "name": "Necesse",
  "category": "Sandbox",
  "icon": "🗺️",
  "description": "Necesse dedicated server — tiny footprint, ideal for a small VPS.",
  "defaultMemory": 2048,
  "variables": [
    { "name": "MAX_PLAYERS", "label": "Max players", "type": "number", "default": 10 },
    { "name": "WORLD_NAME", "label": "World name", "default": "world" },
    { "name": "SERVER_PASSWORD", "label": "Join password", "default": "" }
  ],
  "ports": [{ "name": "game", "default": 14159, "protocol": "udp" }],
  "install": [
    { "type": "java", "version": "17", "label": "Install Java 17" },
    { "type": "steamcmd", "appid": "1169370", "label": "Install Necesse dedicated server" },
    { "type": "chmod", "path": "StartServer-nogui.sh", "mode": "+x" }
  ],
  "configFiles": [
    {
      "path": "cfg/server.cfg",
      "mode": "create",
      "content": "world = {{WORLD_NAME}}\nport = {{PORT}}\nslots = {{MAX_PLAYERS}}\npassword = {{SERVER_PASSWORD}}\nmotd = Welcome to {{SERVER_NAME}}\npausewhenempty = true\n"
    }
  ],
  "startCommand": "java -Xmx{{MEMORY}}M -jar Server.jar -nogui -port {{PORT}} -world \"{{WORLD_NAME}}\" -slots {{MAX_PLAYERS}}",
  "stopCommand": "stop",
  "stopTimeout": 45,
  "query": { "type": "udp", "port": "game" },
  "logPatterns": {
    "ready": "Server started|Loaded world",
    "join": "([^ ]+) joined the game",
    "leave": "([^ ]+) left the game"
  }
}
