{
  "id": "counter-strike-source",
  "name": "Counter-Strike: Source",
  "category": "Shooter",
  "icon": "💣",
  "storeAppId": 240,
  "description": "The classic Source-engine Counter-Strike. Light on resources; add a GSLT to list it publicly.",
  "platforms": [
    "linux",
    "windows"
  ],
  "defaultMemory": 2048,
  "variables": [
    {
      "name": "MAP",
      "label": "Starting map",
      "default": "de_dust2",
      "options": [
        "de_dust2",
        "de_dust",
        "de_inferno",
        "de_nuke",
        "de_train",
        "de_aztec",
        "de_cbble",
        "de_piranesi",
        "de_prodigy",
        "cs_office",
        "cs_italy",
        "cs_assault",
        "cs_compound",
        "cs_havana",
        "cs_militia"
      ],
      "allowCustom": true
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "default": 24,
      "type": "number"
    },
    {
      "name": "GSLT",
      "label": "Steam game server token (GSLT)",
      "default": "",
      "description": "Optional. Lists the server publicly; get one at steamcommunity.com/dev/managegameservers."
    },
    {
      "name": "RCON_PASSWORD",
      "label": "RCON password",
      "default": "",
      "generate": "password"
    },
    {
      "name": "FRIENDLY_FIRE",
      "label": "Friendly fire",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "description": "Teammates can hurt each other.",
      "group": "Rules"
    },
    {
      "name": "ROUND_TIME",
      "label": "Round time (minutes)",
      "type": "number",
      "default": "",
      "description": "Blank keeps the game default.",
      "group": "Rules"
    },
    {
      "name": "FREEZE_TIME",
      "label": "Freeze time (seconds)",
      "type": "number",
      "default": "",
      "description": "The pause at the start of a round.",
      "group": "Rules"
    },
    {
      "name": "START_MONEY",
      "label": "Starting money",
      "type": "number",
      "default": "",
      "description": "Blank keeps the game default.",
      "group": "Rules"
    },
    {
      "name": "MAX_ROUNDS",
      "label": "Rounds per map",
      "type": "number",
      "default": "",
      "description": "0 means no limit.",
      "group": "Rules"
    },
    {
      "name": "AUTO_TEAM_BALANCE",
      "label": "Auto team balance",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "ALLTALK",
      "label": "Everyone can hear everyone",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Game default"
        },
        {
          "value": "1",
          "label": "On"
        },
        {
          "value": "0",
          "label": "Off"
        }
      ],
      "description": "Dead players and the other team hear voice chat too.",
      "group": "Rules"
    },
    {
      "name": "BOT_QUOTA",
      "label": "Bots",
      "type": "number",
      "default": "",
      "description": "How many bots fill the server. 0 for none.",
      "group": "Rules"
    },
    {
      "name": "TIME_LIMIT",
      "label": "Time limit per map (minutes)",
      "type": "number",
      "default": "",
      "description": "0 means no limit. Blank keeps the game default.",
      "group": "Rules"
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "tv",
      "default": 27020,
      "protocol": "udp",
      "offset": 5
    }
  ],
  "image": "cm2network/steamcmd:root",
  "install": [
    {
      "type": "steamcmd",
      "appid": "232330",
      "label": "Install the Counter-Strike: Source dedicated server"
    },
    {
      "type": "chmod",
      "path": "srcds_run",
      "mode": "+x"
    }
  ],
  "configFiles": [
    {
      "path": "cstrike/cfg/server.cfg",
      "mode": "create",
      "content": "hostname \"{{SERVER_NAME}}\"\nrcon_password \"{{RCON_PASSWORD}}\"\nsv_lan 0\n"
    },
    {
      "path": "cstrike/cfg/gamepanel-rules.cfg",
      "mode": "overwrite",
      "content": "// Written by GamePanel from the game settings. A blank value leaves the game default alone.\nmp_friendlyfire {{FRIENDLY_FIRE}}\nmp_roundtime {{ROUND_TIME}}\nmp_freezetime {{FREEZE_TIME}}\nmp_startmoney {{START_MONEY}}\nmp_maxrounds {{MAX_ROUNDS}}\nmp_autoteambalance {{AUTO_TEAM_BALANCE}}\nsv_alltalk {{ALLTALK}}\nbot_quota {{BOT_QUOTA}}\nmp_timelimit {{TIME_LIMIT}}\n"
    }
  ],
  "startCommand": "./srcds_run -console -norestart -game cstrike -port {{PORT}} +maxplayers {{MAX_PLAYERS}} +tv_port {{PORT_TV}} +map {{MAP}} +sv_setsteamaccount \"{{GSLT}}\" +exec gamepanel-rules.cfg",
  "stopCommand": "quit",
  "stopTimeout": 45,
  "query": {
    "type": "a2s",
    "port": "game"
  },
  "rcon": {
    "type": "source",
    "port": "game"
  },
  "logPatterns": {
    "ready": "VAC secure mode|gameserver Steam ID|Connection to Steam servers successful",
    "join": "\"([^<]+)<[0-9]+><[^>]*><>\" entered the game",
    "leave": "\"([^<]+)<[0-9]+><[^>]*><[^>]*>\" disconnected"
  },
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "232330",
        "label": "Install the Counter-Strike: Source dedicated server"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      }
    ],
    "startCommand": "srcds.exe -console -nocrashdialog -condebug -game cstrike -port {{PORT}} +maxplayers {{MAX_PLAYERS}} +tv_port {{PORT_TV}} +map {{MAP}} +sv_setsteamaccount \"{{GSLT}}\" +exec gamepanel-rules.cfg",
    "tailFiles": [
      "cstrike/console.log"
    ],
    "consoleInput": false,
    "stopCommand": null,
    "stopRconCommand": "quit"
  },
  "pty": true
}
