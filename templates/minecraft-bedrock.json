{
  "id": "minecraft-bedrock",
  "name": "Minecraft: Bedrock",
  "category": "Minecraft",
  "icon": "🧱",
  "logo": "/img/games/minecraft.svg",
  "description": "Official Bedrock Edition dedicated server for console, mobile and Windows 10 players.",
  "defaultMemory": 2048,
  "variables": [
    {
      "name": "BEDROCK_VERSION",
      "label": "Bedrock server version",
      "default": "latest",
      "description": "Bedrock dedicated server build.",
      "source": "bedrock-version"
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "type": "number",
      "default": 10
    },
    {
      "name": "MOTD",
      "label": "Server name",
      "default": "GamePanel Bedrock"
    },
    {
      "name": "GAMEMODE",
      "label": "Game mode",
      "default": "survival",
      "options": [
        "survival",
        "creative",
        "adventure"
      ]
    },
    {
      "name": "DIFFICULTY",
      "label": "Difficulty",
      "default": "easy",
      "options": [
        "peaceful",
        "easy",
        "normal",
        "hard"
      ]
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 19132,
      "protocol": "udp"
    },
    {
      "name": "game6",
      "default": 19133,
      "protocol": "udp",
      "offset": 1
    }
  ],
  "install": [
    {
      "type": "apt",
      "packages": [
        "unzip",
        "libcurl4",
        "curl"
      ],
      "label": "Install dependencies"
    },
    {
      "type": "download",
      "label": "Download Bedrock dedicated server {{RESOLVED_VERSION}}",
      "url": "{{DOWNLOAD_URL}}",
      "dest": "bedrock.zip",
      "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"
    },
    {
      "type": "extract",
      "file": "bedrock.zip",
      "dest": ".",
      "deleteArchive": true
    },
    {
      "type": "chmod",
      "path": "bedrock_server",
      "mode": "+x"
    }
  ],
  "patchProperties": [
    {
      "path": "server.properties",
      "format": "properties",
      "createIfMissing": true,
      "set": {
        "server-port": "{{PORT}}",
        "server-portv6": "{{PORT_GAME6}}",
        "server-name": "{{MOTD}}",
        "max-players": "{{MAX_PLAYERS}}",
        "gamemode": "{{GAMEMODE}}",
        "difficulty": "{{DIFFICULTY}}"
      }
    }
  ],
  "startCommand": "LD_LIBRARY_PATH=. ./bedrock_server",
  "stopCommand": "stop",
  "stopTimeout": 30,
  "query": {
    "type": "bedrock",
    "port": "game"
  },
  "logPatterns": {
    "ready": "Server started",
    "join": "Player connected: ([^,]+)",
    "leave": "Player disconnected: ([^,]+)"
  },
  "image": "debian:bookworm-slim",
  "packages": [
    "libcurl4",
    "ca-certificates",
    "curl",
    "unzip"
  ],
  "resolve": "bedrock",
  "platforms": [
    "linux",
    "windows"
  ],
  "windows": {
    "install": [
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      },
      {
        "type": "download",
        "label": "Download Bedrock dedicated server {{RESOLVED_VERSION}}",
        "url": "{{DOWNLOAD_URL}}",
        "dest": "bedrock.zip",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"
      },
      {
        "type": "extract",
        "file": "bedrock.zip",
        "dest": ".",
        "deleteArchive": true
      }
    ],
    "startCommand": "bedrock_server.exe"
  }
}
