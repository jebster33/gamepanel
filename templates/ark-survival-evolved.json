{
  "id": "ark-survival-evolved",
  "name": "ARK: Survival Evolved",
  "category": "Survival",
  "icon": "🦖",
  "storeAppId": 346110,
  "description": "ARK: Survival Evolved dedicated server. Large install and very RAM-hungry — 16 GB recommended.",
  "defaultMemory": 12288,
  "variables": [
    {
      "name": "MAP",
      "label": "Map",
      "default": "TheIsland",
      "description": "Maps shipped with the dedicated server.",
      "options": [
        "TheIsland",
        "TheCenter",
        "ScorchedEarth_P",
        "Ragnarok",
        "Aberration_P",
        "Extinction",
        "Valguero_P",
        "CrystalIsles",
        "Genesis",
        "Gen2",
        "LostIsland",
        "Fjordur"
      ],
      "allowCustom": true
    },
    {
      "name": "MAX_PLAYERS",
      "label": "Max players",
      "type": "number",
      "default": 20
    },
    {
      "name": "SERVER_PASSWORD",
      "label": "Join password",
      "default": ""
    },
    {
      "name": "ADMIN_PASSWORD",
      "label": "Admin password",
      "generate": "password",
      "default": ""
    },
    {
      "name": "RCON_PASSWORD",
      "label": "RCON password",
      "generate": "password",
      "default": ""
    },
    {
      "name": "XP_MULTIPLIER",
      "label": "XP multiplier",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "HARVEST_MULTIPLIER",
      "label": "Harvest amount multiplier",
      "type": "number",
      "default": 1,
      "description": "How much each hit on a tree or rock gives.",
      "group": "Rates"
    },
    {
      "name": "TAMING_MULTIPLIER",
      "label": "Taming speed multiplier",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "MATING_INTERVAL_MULTIPLIER",
      "label": "Mating interval multiplier",
      "type": "number",
      "default": 1,
      "description": "Lower is faster. 0.5 halves the wait.",
      "group": "Rates"
    },
    {
      "name": "EGG_HATCH_MULTIPLIER",
      "label": "Egg hatch speed multiplier",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "BABY_MATURE_MULTIPLIER",
      "label": "Baby growth speed multiplier",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "DAY_CYCLE_SCALE",
      "label": "Day cycle speed",
      "type": "number",
      "default": 1,
      "group": "Rates"
    },
    {
      "name": "DIFFICULTY_OFFSET",
      "label": "Difficulty (0 to 1)",
      "type": "number",
      "default": 1,
      "description": "1 spawns the highest-level wild creatures.",
      "group": "Rules"
    },
    {
      "name": "SERVER_PVE",
      "label": "PvE (players cannot hurt each other)",
      "default": "False",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "SERVER_HARDCORE",
      "label": "Hardcore (lose your character on death)",
      "default": "False",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "THIRD_PERSON",
      "label": "Third person",
      "default": "True",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "MAP_PLAYER_LOCATION",
      "label": "Show your position on the map",
      "default": "False",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "CROSSHAIR",
      "label": "Crosshair",
      "default": "True",
      "options": [
        {
          "value": "True",
          "label": "Yes"
        },
        {
          "value": "False",
          "label": "No"
        }
      ],
      "group": "Rules"
    },
    {
      "name": "PLAYER_DAMAGE",
      "label": "Player damage multiplier",
      "type": "number",
      "default": 1,
      "group": "Combat"
    },
    {
      "name": "DINO_DAMAGE",
      "label": "Wild creature damage multiplier",
      "type": "number",
      "default": 1,
      "group": "Combat"
    },
    {
      "name": "STRUCTURE_RESISTANCE",
      "label": "Structure resistance multiplier",
      "type": "number",
      "default": 1,
      "description": "Higher means buildings take less damage.",
      "group": "Combat"
    },
    {
      "name": "PLAYER_FOOD_DRAIN",
      "label": "Player food drain multiplier",
      "type": "number",
      "default": 1,
      "group": "Survival"
    },
    {
      "name": "PLAYER_WATER_DRAIN",
      "label": "Player water drain multiplier",
      "type": "number",
      "default": 1,
      "group": "Survival"
    },
    {
      "name": "DINO_FOOD_DRAIN",
      "label": "Creature food drain multiplier",
      "type": "number",
      "default": 1,
      "group": "Survival"
    },
    {
      "name": "RESOURCE_RESPAWN",
      "label": "Resource respawn time multiplier",
      "type": "number",
      "default": 1,
      "description": "Lower is faster. 0.5 halves the wait.",
      "group": "Rates"
    },
    {
      "name": "DINO_COUNT",
      "label": "Wild creature count multiplier",
      "type": "number",
      "default": 1,
      "description": "Lower it if the server lags.",
      "group": "World"
    },
    {
      "name": "AUTOSAVE_MINUTES",
      "label": "Save every (minutes)",
      "type": "number",
      "default": 15,
      "group": "Saving"
    },
    {
      "name": "IDLE_KICK",
      "label": "Kick idle players after (seconds)",
      "type": "number",
      "default": 3600,
      "description": "0 never kicks.",
      "group": "Rules"
    }
  ],
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    },
    {
      "name": "raw",
      "default": 7778,
      "protocol": "udp",
      "offset": 1
    },
    {
      "name": "query",
      "default": 27015,
      "protocol": "udp"
    },
    {
      "name": "rcon",
      "default": 32330,
      "protocol": "tcp"
    }
  ],
  "install": [
    {
      "type": "apt",
      "packages": [
        "lib32gcc-s1",
        "libc6-i386"
      ],
      "label": "Install 32-bit runtime libraries"
    },
    {
      "type": "steamcmd",
      "appid": "376030",
      "label": "Install ARK dedicated server (~15 GB)"
    },
    {
      "type": "chmod",
      "path": "ShooterGame/Binaries/Linux/ShooterGameServer",
      "mode": "+x"
    },
    {
      "type": "download",
      "label": "Fetch the SteamCMD ARK uses for its own mod downloads",
      "url": "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz",
      "dest": "Engine/Binaries/ThirdParty/SteamCMD/Linux/steamcmd_linux.tar.gz"
    },
    {
      "type": "extract",
      "file": "Engine/Binaries/ThirdParty/SteamCMD/Linux/steamcmd_linux.tar.gz",
      "dest": "Engine/Binaries/ThirdParty/SteamCMD/Linux",
      "deleteArchive": true
    }
  ],
  "startCommand": "./ShooterGame/Binaries/Linux/ShooterGameServer \"{{MAP}}?listen?SessionName={{SERVER_NAME}}?MaxPlayers={{MAX_PLAYERS}}?ServerPassword={{SERVER_PASSWORD}}?ServerAdminPassword={{ADMIN_PASSWORD}}?Port={{PORT}}?QueryPort={{PORT_QUERY}}?RCONEnabled=True?RCONPort={{PORT_RCON}}\" -server -log -NoBattlEye -automanagedmods",
  "stopTimeout": 120,
  "query": {
    "type": "a2s",
    "port": "query"
  },
  "rcon": {
    "type": "source",
    "port": "rcon"
  },
  "stopRconCommand": "DoExit",
  "logPatterns": {
    "ready": "Full Startup:|Server has completed startup",
    "join": "([^ ]+) joined this ARK",
    "leave": "([^ ]+) left this ARK"
  },
  "image": "cm2network/steamcmd:root",
  "mods": {
    "providers": [
      "workshop"
    ],
    "dir": "ShooterGame/Content/Mods",
    "appId": 346110,
    "workshop": {
      "strategy": "list",
      "file": "ShooterGame/Saved/Config/LinuxServer/GameUserSettings.ini",
      "section": "ServerSettings",
      "key": "ActiveMods"
    }
  },
  "platforms": [
    "linux",
    "windows"
  ],
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "376030",
        "label": "Install ARK dedicated server (~15 GB)"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      },
      {
        "type": "directx",
        "label": "Install the DirectX runtime"
      },
      {
        "type": "download",
        "label": "Fetch the SteamCMD ARK uses for its own mod downloads",
        "url": "https://steamcdn-a.akamaihd.net/client/installer/steamcmd.zip",
        "dest": "Engine/Binaries/ThirdParty/SteamCMD/Win64/steamcmd.zip"
      },
      {
        "type": "extract",
        "file": "Engine/Binaries/ThirdParty/SteamCMD/Win64/steamcmd.zip",
        "dest": "Engine/Binaries/ThirdParty/SteamCMD/Win64",
        "deleteArchive": true
      }
    ],
    "startCommand": "ShooterGame\\Binaries\\Win64\\ShooterGameServer.exe \"{{MAP}}?listen?SessionName={{SERVER_NAME}}?MaxPlayers={{MAX_PLAYERS}}?ServerPassword={{SERVER_PASSWORD}}?ServerAdminPassword={{ADMIN_PASSWORD}}?Port={{PORT}}?QueryPort={{PORT_QUERY}}?RCONEnabled=True?RCONPort={{PORT_RCON}}\" -server -log -automanagedmods -NoBattlEye",
    "tailFiles": [
      "ShooterGame/Saved/Logs/ShooterGame.log"
    ],
    "mods": {
      "workshop": {
        "strategy": "list",
        "file": "ShooterGame/Saved/Config/WindowsServer/GameUserSettings.ini",
        "section": "ServerSettings",
        "key": "ActiveMods"
      }
    },
    "patchProperties": [
      {
        "path": "ShooterGame/Saved/Config/WindowsServer/GameUserSettings.ini",
        "format": "ini",
        "section": "ServerSettings",
        "createIfMissing": true,
        "set": {
          "XPMultiplier": "{{XP_MULTIPLIER}}",
          "HarvestAmountMultiplier": "{{HARVEST_MULTIPLIER}}",
          "TamingSpeedMultiplier": "{{TAMING_MULTIPLIER}}",
          "MatingIntervalMultiplier": "{{MATING_INTERVAL_MULTIPLIER}}",
          "EggHatchSpeedMultiplier": "{{EGG_HATCH_MULTIPLIER}}",
          "BabyMatureSpeedMultiplier": "{{BABY_MATURE_MULTIPLIER}}",
          "DayCycleSpeedScale": "{{DAY_CYCLE_SCALE}}",
          "DifficultyOffset": "{{DIFFICULTY_OFFSET}}",
          "ServerPVE": "{{SERVER_PVE}}",
          "ServerHardcore": "{{SERVER_HARDCORE}}",
          "AllowThirdPersonPlayer": "{{THIRD_PERSON}}",
          "ShowMapPlayerLocation": "{{MAP_PLAYER_LOCATION}}",
          "ServerCrosshair": "{{CROSSHAIR}}",
          "PlayerDamageMultiplier": "{{PLAYER_DAMAGE}}",
          "DinoDamageMultiplier": "{{DINO_DAMAGE}}",
          "StructureResistanceMultiplier": "{{STRUCTURE_RESISTANCE}}",
          "PlayerCharacterFoodDrainMultiplier": "{{PLAYER_FOOD_DRAIN}}",
          "PlayerCharacterWaterDrainMultiplier": "{{PLAYER_WATER_DRAIN}}",
          "DinoCharacterFoodDrainMultiplier": "{{DINO_FOOD_DRAIN}}",
          "ResourcesRespawnPeriodMultiplier": "{{RESOURCE_RESPAWN}}",
          "AutoSavePeriodMinutes": "{{AUTOSAVE_MINUTES}}",
          "KickIdlePlayersPeriod": "{{IDLE_KICK}}"
        }
      }
    ]
  },
  "tailFiles": [
    "ShooterGame/Saved/Logs/ShooterGame.log"
  ],
  "ci": {
    "bootTimeout": 1800
  },
  "patchProperties": [
    {
      "path": "ShooterGame/Saved/Config/LinuxServer/GameUserSettings.ini",
      "format": "ini",
      "section": "ServerSettings",
      "createIfMissing": true,
      "set": {
        "XPMultiplier": "{{XP_MULTIPLIER}}",
        "HarvestAmountMultiplier": "{{HARVEST_MULTIPLIER}}",
        "TamingSpeedMultiplier": "{{TAMING_MULTIPLIER}}",
        "MatingIntervalMultiplier": "{{MATING_INTERVAL_MULTIPLIER}}",
        "EggHatchSpeedMultiplier": "{{EGG_HATCH_MULTIPLIER}}",
        "BabyMatureSpeedMultiplier": "{{BABY_MATURE_MULTIPLIER}}",
        "DayCycleSpeedScale": "{{DAY_CYCLE_SCALE}}",
        "DifficultyOffset": "{{DIFFICULTY_OFFSET}}",
        "ServerPVE": "{{SERVER_PVE}}",
        "ServerHardcore": "{{SERVER_HARDCORE}}",
        "AllowThirdPersonPlayer": "{{THIRD_PERSON}}",
        "ShowMapPlayerLocation": "{{MAP_PLAYER_LOCATION}}",
        "ServerCrosshair": "{{CROSSHAIR}}",
        "PlayerDamageMultiplier": "{{PLAYER_DAMAGE}}",
        "DinoDamageMultiplier": "{{DINO_DAMAGE}}",
        "StructureResistanceMultiplier": "{{STRUCTURE_RESISTANCE}}",
        "PlayerCharacterFoodDrainMultiplier": "{{PLAYER_FOOD_DRAIN}}",
        "PlayerCharacterWaterDrainMultiplier": "{{PLAYER_WATER_DRAIN}}",
        "DinoCharacterFoodDrainMultiplier": "{{DINO_FOOD_DRAIN}}",
        "ResourcesRespawnPeriodMultiplier": "{{RESOURCE_RESPAWN}}",
        "AutoSavePeriodMinutes": "{{AUTOSAVE_MINUTES}}",
        "KickIdlePlayersPeriod": "{{IDLE_KICK}}"
      }
    }
  ],
  "presets": [
    {
      "id": "1x",
      "label": "1x (official rates)",
      "description": "standard rates",
      "vars": {
        "XP_MULTIPLIER": 1,
        "HARVEST_MULTIPLIER": 1,
        "TAMING_MULTIPLIER": 1,
        "MATING_INTERVAL_MULTIPLIER": 1,
        "EGG_HATCH_MULTIPLIER": 1,
        "BABY_MATURE_MULTIPLIER": 1,
        "RESOURCE_RESPAWN": 1
      }
    },
    {
      "id": "2x",
      "label": "2x",
      "description": "double rates",
      "vars": {
        "XP_MULTIPLIER": 2,
        "HARVEST_MULTIPLIER": 2,
        "TAMING_MULTIPLIER": 2,
        "MATING_INTERVAL_MULTIPLIER": 0.5,
        "EGG_HATCH_MULTIPLIER": 2,
        "BABY_MATURE_MULTIPLIER": 2,
        "RESOURCE_RESPAWN": 0.75
      }
    },
    {
      "id": "3x",
      "label": "3x",
      "description": "triple rates",
      "vars": {
        "XP_MULTIPLIER": 3,
        "HARVEST_MULTIPLIER": 3,
        "TAMING_MULTIPLIER": 3,
        "MATING_INTERVAL_MULTIPLIER": 0.4,
        "EGG_HATCH_MULTIPLIER": 3,
        "BABY_MATURE_MULTIPLIER": 3,
        "RESOURCE_RESPAWN": 0.6
      }
    },
    {
      "id": "5x",
      "label": "5x",
      "description": "five times the rates",
      "vars": {
        "XP_MULTIPLIER": 5,
        "HARVEST_MULTIPLIER": 5,
        "TAMING_MULTIPLIER": 5,
        "MATING_INTERVAL_MULTIPLIER": 0.25,
        "EGG_HATCH_MULTIPLIER": 5,
        "BABY_MATURE_MULTIPLIER": 5,
        "RESOURCE_RESPAWN": 0.5
      }
    },
    {
      "id": "10x",
      "label": "10x",
      "description": "ten times the rates",
      "vars": {
        "XP_MULTIPLIER": 10,
        "HARVEST_MULTIPLIER": 10,
        "TAMING_MULTIPLIER": 10,
        "MATING_INTERVAL_MULTIPLIER": 0.1,
        "EGG_HATCH_MULTIPLIER": 10,
        "BABY_MATURE_MULTIPLIER": 10,
        "RESOURCE_RESPAWN": 0.4
      }
    }
  ]
}
