{
  "id": "scp-secret-laboratory",
  "name": "SCP: Secret Laboratory",
  "category": "Shooter",
  "icon": "🔬",
  "storeAppId": 700330,
  "description": "Free multiplayer horror shooter set in the SCP Foundation. Runs through the official LocalAdmin console, with the EULA accepted for you.",
  "platforms": [
    "linux",
    "windows"
  ],
  "defaultMemory": 3072,
  "variables": [],
  "ports": [
    {
      "name": "game",
      "default": 7777,
      "protocol": "udp"
    }
  ],
  "image": "cm2network/steamcmd:root",
  "install": [
    {
      "type": "steamcmd",
      "appid": "996560",
      "label": "Install the SCP: Secret Laboratory dedicated server"
    },
    {
      "type": "chmod",
      "path": "LocalAdmin",
      "mode": "+x"
    },
    {
      "type": "chmod",
      "path": "SCPSL.x86_64",
      "mode": "+x"
    }
  ],
  "startCommand": "HOME=\"{{SERVER_DIR}}\" DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 ./LocalAdmin {{PORT}} --useDefault --acceptEULA --printStd --noSetCursor",
  "stopCommand": "exit",
  "stopTimeout": 30,
  "readyOnPort": "game",
  "query": {
    "type": "udp",
    "port": "game"
  },
  "logPatterns": {
    "ready": "Server is ready|Waiting for players",
    "join": "Player (.+?) \\(\\d+@steam\\) connected",
    "leave": "(.+?) \\(\\d+@steam\\) disconnected"
  },
  "windows": {
    "install": [
      {
        "type": "steamcmd",
        "appid": "996560",
        "label": "Install the SCP: Secret Laboratory dedicated server"
      },
      {
        "type": "vcredist",
        "label": "Install the Visual C++ runtime"
      }
    ],
    "startCommand": "LocalAdmin.exe {{PORT}} --useDefault --acceptEULA --printStd --noSetCursor"
  }
}
